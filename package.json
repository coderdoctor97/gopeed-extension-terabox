{
  "name": "gopeed-extension-terabox",
  "version": "1.0.0",
  "description": "Gopeed extension that resolves TeraBox share links into direct, multi-connection download links",
  "author": "Satya",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "test": "node --test test/",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint --ext .js,.mjs src test scripts",
    "format": "prettier --write \"{src,test,scripts}/**/*.{js,mjs}\" manifest.json",
    "set-repo": "node scripts/set-repo.mjs",
    "zip": "node scripts/zip.mjs",
    "check-bundle": "node scripts/check-bundle.mjs"
  },
  "keywords": [
    "gopeed",
    "gopeed-extension",
    "terabox"
  ],
  "devDependencies": {
    "@babel/core": "^7.22.20",
    "@babel/preset-env": "^7.22.20",
    "babel-loader": "^9.1.3",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "gopeed": "^1.7.0",
    "gopeed-polyfill-webpack-plugin": "^1.0.6",
    "prettier": "^3.0.3",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  }
}
